# Nazakat — environment template. Names + safe placeholders only.
# NEVER commit real values. Each feature stays disabled until its vars are set
# AND its FEATURE_* flag is "true" (see docs/PROVIDER_MATRIX.md).

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Milestone 2: auth, DB, storage) ---------------------------
# Without these: sign-up/login show "opens soon".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only, never NEXT_PUBLIC

# --- Chat LLM (Milestone 3) ----------------------------------------------
# Without these: chat shows "provider unavailable", never a fake reply.
AI_CHAT_PROVIDER=anthropic
AI_CHAT_API_KEY=                      # server-only; chat also needs SUPABASE_SERVICE_ROLE_KEY
AI_CHAT_MODEL=claude-opus-5-5         # claude-haiku-5-5 is ~40x cheaper per token
FREE_DAILY_MESSAGES=60

# --- Sign-in methods (email OTP works as soon as Supabase is set) ---------
# Also enable each provider in Supabase → Authentication → Providers.
AUTH_PHONE_ENABLED=false              # needs an SMS provider + DLT registration in India
AUTH_GOOGLE_ENABLED=false
AUTH_DISCORD_ENABLED=false
AI_MODERATION_PROVIDER=               # optional separate moderation provider
AI_MODERATION_API_KEY=

# --- Memory embeddings (Milestone 3) -------------------------------------
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_API_KEY=                   # server-only

# --- Image generation (V1.1, after provider terms approval) --------------
IMAGE_PROVIDER=
IMAGE_PROVIDER_API_KEY=
FEATURE_IMAGE_GEN=false

# --- Voice (V2) ----------------------------------------------------------
VOICE_PROVIDER=
VOICE_PROVIDER_API_KEY=
FEATURE_VOICE=false

# --- Video (V2) ----------------------------------------------------------
VIDEO_PROVIDER=
VIDEO_PROVIDER_API_KEY=

# --- Payments (only after written provider approval) ---------------------
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_SECRET_KEY=                   # server-only
PAYMENT_WEBHOOK_SECRET=               # server-only
FEATURE_PAYMENTS=false

# --- Messaging -----------------------------------------------------------
SMS_PROVIDER=                         # configured inside Supabase Auth (needs DLT in India)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=

# --- Abuse / rate limits -------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Observability (consent-gated analytics) ------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
