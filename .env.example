# Nazakat — environment template. Names + safe placeholders only.
# NEVER commit real values. Each feature stays disabled until its vars are set
# AND its FEATURE_* flag is "true" (see docs/PROVIDER_MATRIX.md).

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Milestone 2: auth, DB, storage) ---------------------------
# Without these: sign-up/login show "opens soon".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only, never NEXT_PUBLIC

# --- Chat LLM (Milestone 3) ----------------------------------------------
# Without these: chat shows "provider unavailable", never a fake reply.
AI_CHAT_PROVIDER=anthropic
AI_CHAT_API_KEY=                      # server-only; chat also needs SUPABASE_SERVICE_ROLE_KEY
AI_CHAT_MODEL=claude-opus-5-5         # claude-haiku-5-5 is ~40x cheaper per token
FREE_DAILY_MESSAGES=60

# --- Sign-in methods (email OTP works as soon as Supabase is set) ---------
# Also enable each provider in Supabase → Authentication → Providers.
AUTH_PHONE_ENABLED=false              # needs an SMS provider + DLT registration in India
AUTH_GOOGLE_ENABLED=false
AUTH_DISCORD_ENABLED=false
AI_MODERATION_PROVIDER=               # optional separate moderation provider
AI_MODERATION_API_KEY=

# --- Memory embeddings (Milestone 3) -------------------------------------
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_API_KEY=                   # server-only

# --- Photos & videos (fal.ai) -------------------------------------------
# Comma-separated fallback chains; a model is skipped if it can't make the
# requested length. Safety checkers stay on.
FAL_KEY=                              # server-only
FEATURE_IMAGE_GEN=false
FEATURE_VIDEO_GEN=false
FAL_IMAGE_MODELS=fal-ai/flux/dev,fal-ai/flux/schnell
FAL_VIDEO_MODELS=fal-ai/kling-video/v3/pro/text-to-video,fal-ai/bytedance/seedance/v1/pro/text-to-video
FAL_I2V_MODELS=fal-ai/kling-video/v3/pro/image-to-video

# --- Voice: calls + voice notes ------------------------------------------
# Provider order with automatic fallback. Either key alone is enough.
VOICE_PROVIDERS=sarvam,elevenlabs
FEATURE_VOICE_CALLS=false
FEATURE_VOICE_NOTES=false
SARVAM_API_KEY=                       # server-only (dashboard.sarvam.ai)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v4
SARVAM_SPEAKER_FEMALE=ritu
SARVAM_SPEAKER_MALE=shubh
ELEVENLABS_API_KEY=                   # server-only (premium voices / fallback)
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_MALE=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2

# --- Sparks prices (1 ✦ ≈ ₹1); defaults shown -----------------------------
NEXT_PUBLIC_SPARKS_IMAGE=10
NEXT_PUBLIC_SPARKS_VIDEO_5=60
NEXT_PUBLIC_SPARKS_VIDEO_8=95
NEXT_PUBLIC_SPARKS_VIDEO_10=120
NEXT_PUBLIC_SPARKS_VIDEO_15=180
NEXT_PUBLIC_SPARKS_CALL_MINUTE=12
NEXT_PUBLIC_SPARKS_VOICE_NOTE=3

# --- Payments (only after written provider approval) ---------------------
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_SECRET_KEY=                   # server-only
PAYMENT_WEBHOOK_SECRET=               # server-only
FEATURE_PAYMENTS=false

# --- Messaging -----------------------------------------------------------
SMS_PROVIDER=                         # configured inside Supabase Auth (needs DLT in India)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=

# --- Abuse / rate limits -------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Observability (consent-gated analytics) ------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
